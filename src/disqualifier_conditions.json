{
  "disqualification_rules": [
    {
      "id": "min_experience",
      "field": "years_of_experience",
      "operator": "<",
      "value": 4,
      "action": "DISQUALIFY"
    },

    {
      "id": "country_relocation",
      "conditions": [
        {
          "field": "country",
          "operator": "!=",
          "value": "India"
        },
        {
          "field": "willing_to_relocate",
          "operator": "==",
          "value": false
        }
      ],
      "logic": "AND",
      "action": "DISQUALIFY"
    },

    {
      "id": "location_relocation",
      "conditions": [
        {
          "field": "location",
          "operator": "NOT_IN",
          "value": [
            "noida",
            "pune",
            "hyderabad",
            "mumbai",
            "delhi ncr",
            "bangalore",
            "bangaluru"
          ]
        },
        {
          "field": "willing_to_relocate",
          "operator": "==",
          "value": false
        }
      ],
      "logic": "AND",
      "action": "DISQUALIFY"
    },

    {
      "id": "non_coding_title",
      "field": "current_title",
      "operator": "REGEX",
      "value": "(customer support|accountant|hr|recruiter|talent acquisition)",
      "action": "DISQUALIFY"
    },

    {
    "id": "conditional_non_coding_titles",
    "field": "current_title",
    "operator": "REGEX",
    "value": "(manager|executive|business|content|marketing)",
    "exceptions": ["engineer", "developer", "ml", "ai", "data"],
    "action": "DISQUALIFY"
    },

    {
      "id": "service_company_only",
      "field": "career_companies",
      "operator": "ALL_IN",
      "value": [
        "tcs",
        "infosys",
        "wipro",
        "accenture",
        "cognizant",
        "capgemini"
      ],
      "action": "DISQUALIFY"
    }
  ],

  "activity_rules": [
    {
      "id": "active_not_open_to_work",
      "conditions": [
        {
          "field": "open_to_work",
          "operator": "==",
          "value": false
        },
        {
          "field": "last_active_days",
          "operator": "<=",
          "value": 30
        },
        {
          "field": "applications_submitted_30d",
          "operator": ">",
          "value": 3
        },
        {
          "field": "avg_response_time_hours",
          "operator": "<",
          "value": 48
        }
      ],
      "logic": "AND",
      "action": "ALLOW"
    },

    {
      "id": "active_open_to_work",
      "conditions": [
        {
          "field": "open_to_work",
          "operator": "==",
          "value": true
        },
        {
          "field": "last_active_days",
          "operator": "<=",
          "value": 30
        },
        {
          "field": "applications_submitted_30d",
          "operator": ">",
          "value": 1
        },
        {
          "field": "avg_response_time_hours",
          "operator": "<",
          "value": 72
        }
      ],
      "logic": "AND",
      "action": "ALLOW"
    },

    {
      "id": "inactive_not_open_to_work",
      "conditions": [
        {
          "field": "open_to_work",
          "operator": "==",
          "value": false
        },
        {
          "field": "last_active_days",
          "operator": ">",
          "value": 30
        },
        {
          "field": "applications_submitted_30d",
          "operator": "<",
          "value": 1
        },
        {
          "field": "avg_response_time_hours",
          "operator": ">",
          "value": 48
        }
      ],
      "logic": "AND",
      "action": "DISQUALIFY"
    },

    {
      "id": "inactive_open_to_work",
      "conditions": [
        {
          "field": "open_to_work",
          "operator": "==",
          "value": true
        },
        {
          "field": "last_active_days",
          "operator": ">",
          "value": 30
        },
        {
          "field": "applications_submitted_30d",
          "operator": "<",
          "value": 1
        },
        {
          "field": "avg_response_time_hours",
          "operator": ">",
          "value": 48
        }
      ],
      "logic": "AND",
      "action": "DISQUALIFY"
    }
  ]
}
